<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 2026-09-16 合规: Android 11 及以下系统要求蓝牙扫描需要位置权限; 12+ 已有 neverForLocation,
         故上限锁到 30 —— 商店审核会问"位置权限干什么用", 这里把答案写进清单 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />

    <!-- 2026-09-14: 扫码要能开相机 — Android 11+ 包可见性过滤下, 不声明 queries 时
         Capacitor 的 resolveActivity(ACTION_IMAGE_CAPTURE) 返回 null → 静默退回相册选图。
         相机本身由系统相机 App 拍摄, 本 App 无需 CAMERA 权限 (Capacitor 视为"支持拍摄")。 -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.GET_CONTENT" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Bolloon"
        android:supportsRtl="true"
        android:theme="@style/Theme.BolloonRokid">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2026-08-12 (Phase 1): Android Agent Runtime 无障碍服务 — observe UI 树 + 全局操作 -->
        <service
            android:name=".BolloonAccessibilityService"
            android:exported="false"
            android:label="Bolloon Agent"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 2026-09-14: Capacitor 拍照/扫码用 FileProvider — authority 必须是 ${applicationId}.fileprovider
             (Capacitor BridgeWebChromeClient 硬编码该 authority; Capacitor 8 库 manifest 为空, 需 App 自己声明) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 2026-08-12 (Phase 2): Shizuku provider — 系统级 API 访问 (shell/pm) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
