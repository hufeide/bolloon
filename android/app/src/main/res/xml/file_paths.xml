<?xml version="1.0" encoding="utf-8"?>
<!--
  2026-09-14: Capacitor 8 的库 manifest 是空的 —— 它自己不声明 FileProvider,
  但 BridgeWebChromeClient.createImageFileUri() 会用
  FileProvider.getUriForFile(context, <applicationId>.fileprovider, ...),
  并把照片写到 getExternalFilesDir(DIRECTORY_PICTURES) (即 <external-files-path>/Pictures)。

  缺这个 provider 时拍照 URI 创建即抛异常 → Capacitor 静默回退到相册选图
  (这就是「扫码添加/扫码入网」打开的是相册不是相机的根因)。

  authority 必须严格是 ${applicationId}.fileprovider —— Capacitor 是硬编码拼出来的。
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- getExternalFilesDir(...) 子树 (相机临时照片在这里) -->
    <external-files-path name="ext_files" path="." />
    <!-- 内部 files/cache 兜底 -->
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
</paths>
