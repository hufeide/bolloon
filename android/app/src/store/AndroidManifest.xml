<?xml version="1.0" encoding="utf-8"?>
<!-- 2026-09-16: 应用商店版 (flavor=store) 的清单覆盖。

     为什么只写"摘除"而不复制整份清单: 复制会在主清单改动时静默漂移 (两份清单不一致是最难查的 bug)。
     tools:node="remove" 让合并器按完全限定类名精确删除, 主清单改动会照常生效。

     摘除理由 (商店审核红线, 非功能性取舍):
       · 无障碍服务 (AccessibilityService) 被用于自动化操作本机界面 —— 各国内商店对"无障碍被用于自动点击"高度敏感,
         且要求单独资质说明; 官网直装版保留该能力, 商店版不提供。
       · Shizuku provider 提供系统级 API 提权通道 (exported ContentProvider) —— 会触发安全扫描告警。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service
            android:name="com.hibs.bolloon.BolloonAccessibilityService"
            tools:node="remove" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            tools:node="remove" />
    </application>
</manifest>
