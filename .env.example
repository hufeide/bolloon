# 关闭社交心跳（每 60s 触发的 liteSocialDecide 周期 LLM 调用）
BOLLOON_AGENT_HEARTBEAT_SOCIAL=0

# 关闭 LLM 健康探针（HealthMonitor 每 60s 的 chat('ping') 模型调用）
# 0 = 仅做轻量客户端初始化检查，不再调模型；缺省/非 0 = 开启
BOLLOON_HEALTH_LLM_CHECK=0

# Supervisor 长期执行层：保持开启，但把 tick 间隔调慢到 5 分钟（默认 30s）
# 这样不会每 30s 都重跑主代理，仅在目标确实需要推进时才每 5 分钟认领一次
# BOLLOON_SUPERVISOR_TICK_MS=300000


# 关闭 Supervisor 长期执行层（每 30s tick 一次，会认领 active 目标并重跑主代理）
# 0 = 不启动长期执行层，彻底停止自动的 source=main-agent LLM 调用；缺省/非 0 = 开启
BOLLOON_SUPERVISOR=0